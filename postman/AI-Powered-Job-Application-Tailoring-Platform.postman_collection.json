                  "pm.test('profile came back', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.email).to.eql(pm.variables.get('email'));",
                  "  pm.expect(json).to.have.property('projects');",
                  "  pm.expect(json).to.have.property('experience');",
                  "});"
                ]
